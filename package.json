{
  "name": "agent-gate-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/daemon",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web && npm run build -w apps/daemon",
    "start": "npm run start -w apps/daemon",
    "test": "npm run test -w apps/daemon"
  }
}

